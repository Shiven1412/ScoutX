# Copy this file to .env.local and fill in only the providers you use.
# Never commit .env.local or place server secrets in NEXT_PUBLIC_* variables.

# App and Supabase (Supabase URL and anon key are intentionally browser-visible)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INITIAL_ADMIN_EMAIL=

# AI providers (Gemini is primary; OpenAI can be used as a fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Signal discovery providers
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Hacker News and public RSS feeds do not require API credentials.

# Stripe billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# Razorpay billing (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_AGENCY=

# OAuth integrations (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Email and webhook encryption (optional)
RESEND_API_KEY=
EMAIL_FROM=
# Use a securely generated, base64-encoded 32-byte key. Do not use this comment as a key.
WEBHOOK_ENCRYPTION_KEY=

# Scheduled jobs: set a securely generated secret of at least 32 characters.
CRON_SECRET=

# Optional observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
